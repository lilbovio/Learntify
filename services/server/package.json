{
  "name": "@learntify/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:accounts": "wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1 --port 8788",
    "db:local": "wrangler d1 migrations apply learntify-local --local --config wrangler.local.jsonc && wrangler d1 execute learntify-local --local --config wrangler.local.jsonc --file local-migrations/0001_dev_mailbox.sql",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@learntify/api-contracts": "workspace:*",
    "@learntify/curriculum": "workspace:*",
    "@learntify/learning": "workspace:*",
    "@learntify/draft-storage": "workspace:*",
    "@learntify/preferences-storage": "workspace:*",
    "better-auth": "1.7.12",
    "hono": "4.13.13"
  },
  "learntify": {
    "layer": "service"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1"
  }
}
